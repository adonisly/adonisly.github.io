---
import '../styles/global.css';
interface Props { title?: string; description?: string; lang?: string; type?: 'website' | 'article'; }
const {
  title = 'Inklinks · Chris Wang',
  description = 'Chris Wang 的个人空间。网络工程、阅读与徒步，以及 ReadMap 和 Bookclub 两个关于阅读的项目。',
  lang = 'zh-CN', type = 'website',
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const nav = [['/', '首页'], ['/projects/', '项目'], ['/blog/', '文字'], ['/about/', '关于']];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfcfa" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Inklinks RSS" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Inklinks" />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header wrap">
      <a class="brand" href="/" aria-label="Inklinks 首页">
        <svg width="30" height="34" viewBox="0 0 30 34" fill="none" aria-hidden="true"><path d="M8 5v24M15 9v16M22 5v24" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="m8 13 14 8M8 21l14-8" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>inklinks<span class="brand-period">.</span></span>
      </a>
      <nav aria-label="主导航">
        {nav.map(([href, label]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="github-link" href="https://github.com/adonisly" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">（新窗口）</span></a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href="/">Inklinks</a><p>一些连接，一路探索。</p></div>
      <div class="footer-right"><div><a href="https://github.com/adonisly" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/rss.xml">RSS</a><a href="/about/">关于</a></div><p>© {new Date().getFullYear()} Chris Wang</p></div>
    </footer>
  </body>
</html>
