---
import '../styles/global.css';
import Localized from '../components/Localized.astro';
interface Props { title?: string; description?: string; lang?: string; type?: 'website' | 'article'; bilingual?: boolean; }
const {
  title = 'Inklinks · Chris Wang',
  description = 'Chris Wang 的个人空间。网络工程、阅读与徒步，以及 ReadMap 和 Bookclub 两个关于阅读的项目。',
  lang = 'zh-CN', type = 'website',
  bilingual = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const nav = [['/', '首页', 'Home'], ['/projects/', '项目', 'Projects'], ['/blog/', '文字', 'Writing'], ['/about/', '关于', 'About']];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#fbfcfa" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Inklinks RSS" href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Inklinks" />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{bilingual ? <Localized zh="跳到正文" en="Skip to content" /> : '跳到正文'}</a>
    <header class:list={['site-header wrap', { 'bilingual-header': bilingual }]}>
      <a class="brand" href="/" aria-label="Inklinks 首页" data-label-zh={bilingual ? 'Inklinks 首页' : undefined} data-label-en={bilingual ? 'Inklinks home' : undefined}>
        <svg width="30" height="34" viewBox="0 0 30 34" fill="none" aria-hidden="true"><path d="M8 5v24M15 9v16M22 5v24" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="m8 13 14 8M8 21l14-8" stroke="currentColor" stroke-width="1.5"/></svg>
        <span>inklinks<span class="brand-period">.</span></span>
      </a>
      <nav aria-label="主导航" data-label-zh={bilingual ? '主导航' : undefined} data-label-en={bilingual ? 'Main navigation' : undefined}>
        {nav.map(([href, label, en]) => <a href={href} aria-current={(href === '/' ? path === '/' : path.startsWith(href)) ? 'page' : undefined}>{bilingual ? <Localized zh={label} en={en} /> : label}</a>)}
      </nav>
      <div class="header-actions"><a class="github-link" href="https://github.com/adonisly" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span><span class="sr-only">{bilingual ? <Localized zh="（新窗口）" en=" (opens in a new tab)" /> : '（新窗口）'}</span></a>
        {bilingual && <button class="language-toggle" type="button" data-language-toggle aria-label="Switch to English" lang="en"><Localized zh="English" en="中文" /></button>}
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a class="footer-brand" href="/">Inklinks</a><p>{bilingual ? <Localized zh="一些连接，一路探索。" en="Making connections. Following curiosity." /> : '一些连接，一路探索。'}</p></div>
      <div class="footer-right"><div><a href="https://github.com/adonisly" target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href="/rss.xml">RSS</a><a href="/about/">{bilingual ? <Localized zh="关于" en="About" /> : '关于'}</a></div><p>© {new Date().getFullYear()} Chris Wang</p></div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('[data-language-toggle]');
      if (toggle) {
        const syncLabels = () => {
          const english = document.documentElement.lang === 'en';
          toggle.setAttribute('aria-label', english ? '切换为中文' : 'Switch to English');
          toggle.lang = english ? 'zh-CN' : 'en';
          document.querySelectorAll<HTMLElement>('[data-label-zh][data-label-en]').forEach(element => {
            element.setAttribute('aria-label', (english ? element.dataset.labelEn : element.dataset.labelZh) || '');
          });
        };
        syncLabels();
        toggle.addEventListener('click', () => {
          const language = document.documentElement.lang === 'en' ? 'zh-CN' : 'en';
          document.documentElement.lang = language;
          syncLabels();
        });
      }
    </script>
  </body>
</html>
