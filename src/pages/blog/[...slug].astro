---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, formatDate } from '../../data/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const minutes = Math.max(1, Math.ceil((post.body ?? '').replace(/\s/g, '').length / 400));
---
<Base title={`${post.data.title} · Inklinks`} description={post.data.description} lang={post.data.lang} type="article">
  <article class="wrap article-shell"><a class="back-link" href="/blog/">← 全部文字</a><header class="article-header"><div class="post-tags">{post.data.tags.map(tag => <a href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><p class="article-meta">Chris Wang <span>·</span> <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> <span>·</span> 约 {minutes} 分钟</p></header><div class="prose"><Content /></div><footer class="article-footer"><a href="/blog/">← 返回文字列表</a><a href="/rss.xml">RSS 订阅</a></footer></article>
</Base>
