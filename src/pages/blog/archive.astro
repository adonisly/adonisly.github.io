---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../data/posts';
const posts = await getPosts();
const years = [...new Set(posts.map(post => post.data.date.getUTCFullYear()))];
---
<Base title="文章归档 · Inklinks"><div class="wrap page-content"><header class="page-heading"><a class="back-link" href="/blog/">← 全部文字</a><h1>文章归档</h1></header>{years.map(year => <section class="archive-year"><h2>{year}</h2><PostList posts={posts.filter(post => post.data.date.getUTCFullYear() === year)} /></section>)}</div></Base>
