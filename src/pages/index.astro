---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostList from '../components/PostList.astro';
import Localized from '../components/Localized.astro';
import { projects } from '../data/projects';
import { getPosts } from '../data/posts';
const posts = (await getPosts()).slice(0, 3);
---
<Base bilingual>
  <section class="hero wrap">
    <div class="hero-main">
      <p class="hello"><Localized zh="你好，我是 Chris Wang" en="Hi, I'm Chris Wang" /></p>
      <h1 class="localized-lines"><Localized zh={'在网络与书页之间，\n连接值得探索的世界。'} en={'Between networks and books,\na world to explore.'} /></h1>
      <p class="hero-role localized-lines" lang="en">{'Consulting Engineering Technical Leader at Cisco,\nfocused on data center and enterprise networking.'}</p>
      <p class="hero-personal"><Localized zh="工作之外，喜欢读书、徒步，也动手做一些让阅读更有意思的小项目。" en="Outside of work, I enjoy reading, hiking, and building projects that make reading more rewarding." /></p>
      <div class="hero-links"><a class="button" href="#projects"><Localized zh="看看我的项目" en="Explore projects" /> <span aria-hidden="true">↓</span></a><a class="quiet-link" href="/about/"><Localized zh="更多关于我" en="More about me" /></a></div>
    </div>
    <aside class="hero-note" aria-label="兴趣与探索" data-label-zh="兴趣与探索" data-label-en="Interests and exploration">
      <svg viewBox="0 0 230 180" fill="none" aria-hidden="true"><path d="M17 134c40 0 32-88 78-88s26 99 70 99c20 0 26-27 50-27" stroke="#86a8b9" stroke-width="1.6" stroke-dasharray="4 7"/><path d="m23 136 36-45 21 25 34-59 47 78 25-35 31 35" stroke="#54796b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="159" cy="38" r="13" stroke="#a9955f" stroke-width="1.5"/><path d="M36 156h158" stroke="#b2c0b8"/></svg>
      <p class="localized-lines"><Localized zh={'保持好奇，\n总有新的路径。'} en={'Stay curious.\nFind new paths.'} /></p>
      <span>Networks, books & trails.</span>
    </aside>
  </section>
  <section class="projects-section wrap" id="projects" aria-labelledby="projects-heading">
    <div class="section-heading"><div><h2 id="projects-heading"><Localized zh="把兴趣，做成可以分享的东西。" en="Interests, made to be shared." /></h2><p><Localized zh={`目前在做的 ${projects.length} 个阅读与开源项目`} en={`${projects.length} projects for reading and open exploration`} /></p></div><a class="text-link" href="/projects/"><Localized zh="全部项目" en="All projects" /> <span aria-hidden="true">↗</span></a></div>
    <div class="project-grid">{projects.map(project => <ProjectCard project={project} bilingual />)}</div>
  </section>
  <section class="writing-section wrap" aria-labelledby="writing-heading">
    <div class="section-heading"><div><h2 id="writing-heading"><Localized zh="写下来，慢慢想。" en="Write it down. Think it through." /></h2><p><Localized zh="关于技术、阅读，以及路上的见闻" en="Notes on technology, books, and time outdoors" /></p></div><a class="text-link" href="/blog/"><Localized zh="全部文字" en="All writing" /> <span aria-hidden="true">↗</span></a></div>
    <PostList posts={posts} bilingual />
  </section>
  <section class="closing-note wrap"><span class="note-line" aria-hidden="true"></span><p><Localized zh="从一个问题出发，去一本书里、去一条路上，找找答案。" en="Start with a question. Follow a book, or a trail, and see where it leads." /></p><a href="/rss.xml"><Localized zh="通过 RSS 订阅文字" en="Subscribe via RSS" /> <span aria-hidden="true">↗</span></a></section>
</Base>
